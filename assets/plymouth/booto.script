# Solid white Booto logo centred on black, loading bar underneath.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo = Image("logo.png");
pixel = Image("pixel.png");
bar_w = logo.GetWidth();
bar_h = 6;
x = Window.GetX() + (Window.GetWidth() - bar_w) / 2;
y = Window.GetY() + Window.GetHeight() / 2 - logo.GetHeight();

logo_sprite = Sprite(logo);
logo_sprite.SetPosition(x, y, 1);

track = Sprite(pixel.Scale(bar_w, bar_h));
track.SetPosition(x, y + logo.GetHeight() + 40, 1);
track.SetOpacity(0.25);

# Live boots have no saved boot-duration, so Plymouth's progress estimate stalls; slide a segment instead.
seg_w = Math.Int(bar_w / 4);
fill = Sprite(pixel.Scale(seg_w, bar_h));
fill.SetZ(2);
t = 0;

fun refresh_callback() {
    global.t = (global.t + 1) % 100;
    pos = Math.Int((bar_w + seg_w) * global.t / 100) - seg_w;
    left = Math.Max(pos, 0);
    w = Math.Min(pos + seg_w, bar_w) - left;
    if (w < 1) w = 1;
    fill.SetImage(pixel.Scale(w, bar_h));
    fill.SetPosition(x + left, y + logo.GetHeight() + 40, 2);
}
Plymouth.SetRefreshFunction(refresh_callback);
